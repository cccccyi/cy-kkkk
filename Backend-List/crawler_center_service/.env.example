# Export these variables into the PHP-FPM or web-server environment. This file is not loaded automatically.
# Use a unique random token of at least 32 printable, non-space characters.
CRAWLER_API_TOKEN=
# Map validated logical or legacy machine selectors to trusted origins. Callers can only select a configured key.
CRAWLER_MACHINE_MAP={"default":"http://127.0.0.1:8011"}
# Optional CA bundle for crawler-service HTTPS connections using a private CA.
CRAWLER_CA_BUNDLE=
CRAZYSMM_API_KEY=
CRAWLER_CENTER_DB_PASSWORD=
CRAWLER_CENTER_CRAWLER_DB_PASSWORD=
CRAWLER_CENTER_COMBAT_DB_PASSWORD=
CRAWLER_CENTER_ES_PASSWORD=
