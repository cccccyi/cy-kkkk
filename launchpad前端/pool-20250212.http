# @hostname = 8.219.252.88
@hostname = localhost
@port = 8090
@host = {{hostname}}:{{port}}


### token 列表
# 支持分页  搜索 keyword   状态 launchStatus 支持 new soon success
# GET http://{{host}}/token/list?pageNum=1&pageSize=2 HTTP/1.1
# GET http://{{host}}/token/list?pageNum=1&pageSize=10&keyword=gy&orderByColumn=created_at&isAsc=ascending&launchStatus=new HTTP/1.1

GET http://{{host}}/token/list?pageNum=1&pageSize=10&wallet=bc1qusagll9t26fcp8w7rhnwsz8fx23hghsvlj0682 HTTP/1.1

### 通过 token id 查询指定token
GET http://{{host}}/token/findTokenOne/023c846d37514e8813868afa303e2a61456190fac0da234766c3ad9a41e97601_0 HTTP/1.1

### 内盘交易记录
# 支持 分页 指定token  指定钱包
# GET http://{{host}}/internal-trade/list?pageNum=1&pageSize=10&token=1&wallet=bc1qcfxv73s0ju44s0kena0d64dy46nkngx056dcjv HTTP/1.1
GET http://{{host}}/internal-trade/list?pageNum=1&pageSize=10&token=1&orderByColumn=created_at&isAsc=descending HTTP/1.1


### 持有人列表
# 支持 分页  指定token  指定钱包
# GET http://{{host}}/token/findHolderList?pageNum=1&pageSize=10&wallet=bc1q69zd9tv6fk2z48zcrnqvzgk8jw3nfq9uqpavu7&token=28 HTTP/1.1
GET http://{{host}}/token/findHolderList?pageNum=1&pageSize=10&token=1 HTTP/1.1


