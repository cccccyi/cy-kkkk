### 计算兑换代币数量
# 买入操作， 指定花费FB数量 计算获取多少目标代币数量
POST http://{{host}}/internal-trade/calTokenAmount HTTP/1.1
content-type: application/json
{
  "token": 1,
  "actionType": "buy",
  "fbAmount": 100000
}

###
# 买入操作，指定获取目标代币数量 计算需要花费多少FB
POST http://{{host}}/internal-trade/calTokenAmount HTTP/1.1
content-type: application/json

{
  "token": 1,
  "actionType": "buy",
  "tokenAmount": 10000000
}

###
# 卖出操作，指定获得的FB数量，计算需要卖出多少目标代币
POST http://{{host}}/internal-trade/calTokenAmount HTTP/1.1
content-type: application/json

{
  "token": 1,
  "actionType": "sell",
  "fbAmount": 0.003
}

###
# 卖出操作，指定卖出的目标代币数量，计算获得的FB数量
POST http://{{host}}/internal-trade/calTokenAmount HTTP/1.1
content-type: application/json

{
  "token": 1,
  "actionType": "sell",
  "tokenAmount": 10000
}



### 内盘交易 - 买入
# 买入指定代币  1.用户向指定钱包地址转入一定数量的FB  2.后端检测收到FB划拨一定数量的目标代币
POST http://{{host}}/internal-trade/trade HTTP/1.1
content-type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1dWlkIjoiNjdhOTI1MjZlMjE1NDU2M2JiYzVlYTNmN2Q3OTE1NzkiLCJ1c2VySWQiOiJiYzFxNjl6ZDl0djZmazJ6NDh6Y3JucXZ6Z2s4anczbmZxOXVxcGF2dTciLCJpYXQiOjE3Mzg5OTExMTF9.Ee14oroeD6dFT_LGIN0KKJp_CMepyag4LgTtbQ_ZSJM

{
  "token": 1,
  "actionType": "buy",
  "fbAmount": 0.4,
  "transferTxid": "2779bfe5c3ea98add0b40894f903bc7a73760fea6aea9d0338c322d3b5b7ac25"
}

### 内盘交易 - 卖出
# 卖出指定代币  1.用户构造费用utxo  2.后端使用费用 utxo 将FB转给用户
POST http://{{host}}/internal-trade/sell HTTP/1.1
content-type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1dWlkIjoiNjdhOTI1MjZlMjE1NDU2M2JiYzVlYTNmN2Q3OTE1NzkiLCJ1c2VySWQiOiJiYzFxNjl6ZDl0djZmazJ6NDh6Y3JucXZ6Z2s4anczbmZxOXVxcGF2dTciLCJpYXQiOjE3Mzg5OTExMTF9.Ee14oroeD6dFT_LGIN0KKJp_CMepyag4LgTtbQ_ZSJM

{
  "token": 1,
  "actionType": "sell",
  "tokenAmount": 1000000,
 // "transferTxid": "2779bfe5c3ea98add0b40894f903bc7a73760fea6aea9d0338c322d3b5b7ac25"
