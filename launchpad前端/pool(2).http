@hostname = 8.219.252.88
# @hostname = localhost
@port = 8090
@host = {{hostname}}:{{port}}


### token 列表
# 支持分页  搜索 keyword   状态 launchStatus 支持 new soon success
# GET http://{{host}}/token/list?pageNum=1&pageSize=2 HTTP/1.1
GET http://{{host}}/token/list?pageNum=1&pageSize=10&keyword=gy&orderByColumn=created_at&isAsc=ascending&launchStatus=new HTTP/1.1

### 通过 token id 查询指定token
GET http://{{host}}/token/findTokenOne/1 HTTP/1.1

### 内盘交易记录
# 支持 分页 指定token  指定钱包
GET http://{{host}}/internal-trade/list?pageNum=1&pageSize=10&token=1&wallet=bc1qcfxv73s0ju44s0kena0d64dy46nkngx056dcjv HTTP/1.1


### 持有人列表
# 支持 分页  指定token  指定钱包
# GET http://{{host}}/token/findHolderList?pageNum=1&pageSize=10&wallet=bc1qcfxv73s0ju44s0kena0d64dy46nkngx056dcjv HTTP/1.1
GET http://{{host}}/token/findHolderList?pageNum=1&pageSize=10&token=1 HTTP/1.1


###
# 钱包签名认证 - 提供随机消息 nonce
GET http://{{host}}/nonce/bc1q69zd9tv6fk2z48zcrnqvzgk8jw3nfq9uqpavu7 HTTP/1.1

###
# 验证钱包签名，并生成token
POST http://{{host}}/verify HTTP/1.1
content-type: application/json

