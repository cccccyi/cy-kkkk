{
  "name": "news-management-api",
  "version": "1.0.0",
  "script": "app.js",
  "instances": "max",
  "exec_mode": "cluster",
  "env": {
    "NODE_ENV": "development",
    "PORT": 3010
  },
  "env_production": {
    "NODE_ENV": "production",
    "PORT": 3010
  },
  "log_file": "./logs/combined.log",
  "out_file": "./logs/out.log",
  "error_file": "./logs/error.log",
  "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
  "merge_logs": true,
  "max_memory_restart": "1G",
  "watch": false,
  "ignore_watch": [
    "node_modules",
    "logs",
    "*.log"
  ],
  "kill_timeout": 5000,
  "wait_ready": true,
  "listen_timeout": 10000
}